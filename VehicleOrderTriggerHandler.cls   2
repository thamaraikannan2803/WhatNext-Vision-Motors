public static void beforeUpdate(
    List<Vehicle_Order__c> newOrders,
    Map<Id, Vehicle_Order__c> oldMap
) {
    for (Vehicle_Order__c order : newOrders) {

        Vehicle_Order__c oldOrder = oldMap.get(order.Id);

        if (oldOrder.Order_Status__c != order.Order_Status__c) {

            if (order.Order_Status__c == 'Delivered') {
                order.Delivery_Date__c = Date.today();
            }
        }
    }
}
